set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=wait_route_netlink_netsetup.sh
source "${SCRIPT_DIR}/wait_route_netlink_netsetup.sh"

LOG_FILE="${SCRIPT_DIR}/wait_route_netlink_wait_false.log"
DAEMON_PID=""

cleanup() {
    [[ -n "${DAEMON_PID}" ]] && kill "${DAEMON_PID}" 2>/dev/null || true
    wait "${DAEMON_PID}" 2>/dev/null || true
    wait_route_netlink_restore_eth0_multicast_route
}

trap cleanup EXIT

wait_route_netlink_move_sd_route_off_eth0

export VSOMEIP_CONFIGURATION="${SCRIPT_DIR}/wait_route_netlink_wait_false.json"
export VSOMEIP_APPLICATION_NAME=routingmanagerd

: >"${LOG_FILE}"
../../../examples/routingmanagerd/routingmanagerd >>"${LOG_FILE}" 2>&1 &
DAEMON_PID=$!

if ! wait_route_netlink_await_routing_ready "${LOG_FILE}" 30; then
    echo "Expected '${WAIT_ROUTE_NETLINK_READY_MSG}' with wait_route_netlink_notification=false (SD route only on ${WAIT_ROUTE_NETLINK_DUMMY_IF})" >&2
    tail -n 40 "${LOG_FILE}" >&2 || true
    exit 1
fi

echo "wait_route_netlink_wait_false_test: routing became ready without SD route on eth0"
