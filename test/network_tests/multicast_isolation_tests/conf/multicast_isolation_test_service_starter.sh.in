# Two lanes, each its own routing host with its own SD port. Lane A notifies
# on 239.195.233.1:50000 and lane B on 239.195.233.0:50000.
VSOMEIP_CONFIGURATION=multicast_isolation_test_service_a.json \
VSOMEIP_APPLICATION_NAME=multicast_isolation_service_A \
    ./multicast_isolation_test_service A &
SERVICE_A_PID=$!

VSOMEIP_CONFIGURATION=multicast_isolation_test_service_b.json \
VSOMEIP_APPLICATION_NAME=multicast_isolation_service_B \
    ./multicast_isolation_test_service B &
SERVICE_B_PID=$!

CLIENT_PID=0
if [ ! -z "$USE_LXC_TEST" ]; then
    ssh -tt -i $SANDBOX_ROOT_DIR/commonapi_main/lxc-config/.ssh/mgc_lxc/rsa_key_file.pub -o StrictHostKeyChecking=no root@$LXC_TEST_SLAVE_IP "bash -ci \"set -m; cd \\\$SANDBOX_TARGET_DIR/vsomeip_lib/test/network_tests/multicast_isolation_tests; ./multicast_isolation_test_client_starter.sh\"" & CLIENT_PID=$!
elif [ ! -z "$USE_DOCKER" ]; then
    docker exec $DOCKER_IMAGE sh -c "cd $DOCKER_TESTS; ./multicast_isolation_test_client_starter.sh" & CLIENT_PID=$!
fi

FAIL=0
wait "$CLIENT_PID" || FAIL=1
wait "$SERVICE_A_PID" || FAIL=1
wait "$SERVICE_B_PID" || FAIL=1

exit "$FAIL"
